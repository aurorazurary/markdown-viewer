{
  "name": "markdown-viewer",
  "private": true,
  "version": "1.1.0",
  "description": "Opens .md files rendered by default; switch to a raw-text page with a formatting toolbar to edit.",
  "author": "aurorazurary",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:exe": "tauri build --no-bundle",
    "start": "tauri build --no-bundle && \"src-tauri/target/release/markdown-viewer.exe\"",
    "test": "tauri build --no-bundle && node test/e2e.mjs",
    "dist:win": "tauri build",
    "tauri": "tauri",
    "screenshots": "node test/screenshots.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "playwright-core": "^1.65.0",
    "vite": "^8.3.8"
  }
}
