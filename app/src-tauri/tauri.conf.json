{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Viewer",
  "version": "1.1.0",
  "identifier": "com.aurorazurary.markdownviewer",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: http: data: blob:; media-src 'self' asset: http://asset.localhost https: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*.png",
          "**/*.jpg",
          "**/*.jpeg",
          "**/*.gif",
          "**/*.svg",
          "**/*.webp",
          "**/*.bmp",
          "**/*.ico",
          "**/*.avif",
          "**/*.PNG",
          "**/*.JPG",
          "**/*.JPEG",
          "**/*.GIF",
          "**/*.SVG",
          "**/*.WEBP",
          "**/*.BMP",
          "**/*.ICO",
          "**/*.AVIF"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "aurorazurary",
    "copyright": "Copyright © 2026 aurorazurary",
    "shortDescription": "Markdown Viewer",
    "longDescription": "Opens .md files rendered by default; switch to a raw-text page with a formatting toolbar to edit.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}